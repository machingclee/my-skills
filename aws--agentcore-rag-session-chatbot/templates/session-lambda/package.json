{
  "name": "{{LAMBDA_SERVICE}}",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "generate": "env-cmd -f .env.local.json npx prisma generate",
    "migrate:create": "env-cmd -f .env.local.json npx prisma migrate dev --create-only",
    "migrate:diff": "env-cmd -f .env.local.json npx prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "migrate:deploy": "env-cmd -f .env.local.json npx prisma migrate deploy",
    "migrate:applied": "env-cmd -f .env.local.json npx prisma migrate resolve --applied ",
    "start": "env-cmd -f .env.local.json ts-node src/app.ts",
    "offline": "serverless offline",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --config serverless-prod.yml",
    "remove": "serverless remove"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "kysely": "^0.27.6",
    "pg": "^8.23.1",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.6",
    "env-cmd": "^10.1.0",
    "prisma": "^7.10.0",
    "prisma-kysely": "^3.2.1",
    "serverless": "3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^12.0.4",
    "serverless-plugin-common-excludes": "^4.0.0",
    "serverless-plugin-typescript-express": "^1.0.8",
    "serverless-prune-plugin": "^2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
